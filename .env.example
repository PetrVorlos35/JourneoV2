# ── Database (MariaDB) ──
DB_HOST=db.dejny.eu
DB_USER=vorel
DB_PASSWORD=
DB_NAME=voreldb
DB_PORT=3306

# ── JWT ──
JWT_SECRET=

# ── Google OAuth ──
# Same value in both. GOOGLE_CLIENT_ID is read server-side to verify Google tokens;
# on Vercel it MUST be set as a server env var (VITE_* vars are build-time only).
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ── Server ──
PORT=3001
# Origin povolený CORS pro frontend (produkční doména).
FRONTEND_URL=

# ── Cron (server/routes/cron.js) ──
# Chrání denní purge koše (GET /api/cron/purge-trash). Bez něj endpoint
# fails closed (401) — Vercel Cron ho posílá jako Bearer token.
CRON_SECRET=

# ── Geokódování (server/lib/geocode.js) ──
# Kontaktní URL/e-mail do User-Agent hlaviček pro Nominatim (jejich
# usage policy to vyžaduje). Bez nastavení padá na výchozí hodnotu.
NOMINATIM_CONTACT=

# ── Databázový pool (server/config/db.js) ──
# Počet DB spojení na jednu (serverless) instanci. Výchozí 5 — zvyšovat
# jen pro dlouhoběžící (non-serverless) nasazení.
DB_POOL_LIMIT=5
